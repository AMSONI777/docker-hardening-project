# --- Stage 1: The "Builder" Stage ---
# We use Python 3.9 to match the final Distroless image.
FROM python:3.9-slim AS builder

WORKDIR /app

# THE CRITICAL CHANGE IS HERE:
# Instead of installing to a system path, we install all libraries
# directly into a local directory named 'packages'.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt --target ./packages

# Copy the application code
COPY app.py .

# --- Stage 2: The "Final" Production Stage (Distroless) ---
# We use the stable Python 3.9 Distroless image.
FROM gcr.io/distroless/python3-debian11

WORKDIR /app

# THE SECOND CRITICAL CHANGE:
# We copy the 'packages' directory and our app.py directly into /app.
# Now, Flask and all its dependencies are right next to our script.
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/app.py .

# We no longer need PYTHONPATH because all modules are in the same folder or a subfolder.

EXPOSE 5000

# The command to run.
CMD ["app.py"]